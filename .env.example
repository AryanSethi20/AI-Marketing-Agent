# ============================================================
# AI Marketing Agent — configuration template
# Copy to `.env` and fill in. Never commit your real .env file.
# ============================================================

# --- Provider selection ---------------------------------------------------
# One of: ollama | openai | groq | openrouter | custom
MODEL_PROVIDER=ollama

# Model identifier understood by the chosen provider, e.g.:
#   ollama     : qwen2.5:32b, llama3.2, mistral
#   openai     : gpt-4o-mini, gpt-4o
#   groq       : llama-3.3-70b-versatile
#   openrouter : meta-llama/llama-3.3-70b-instruct:free
MODEL_NAME=qwen2.5:32b

# --- Credentials (required for openai/groq/openrouter/custom) --------------
# Leave empty for Ollama. NEVER hardcode keys in source files.
OPENAI_API_KEY=

# --- Endpoints --------------------------------------------------------------
# Local Ollama OpenAI-compatible endpoint (default shown).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only used when MODEL_PROVIDER=custom (any OpenAI-compatible server).
# CUSTOM_BASE_URL=https://my-gateway.example.com/v1

# --- Optional tuning ---------------------------------------------------------
# LLM_TEMPERATURE=0.4
# LLM_MAX_RETRIES=3
# REQUEST_TIMEOUT_SECONDS=120
# MAX_SEARCH_RESULTS=8
