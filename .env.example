# AI Marketing Agent - configuration template
# Copy this file to `.env` and fill in what you need:
#   cp .env.example .env
# The real .env is git-ignored. Never commit API keys.

# Provider to route LLM calls through.
# One of: ollama | openai | groq | openrouter | custom
MODEL_PROVIDER=ollama

# Model identifier understood by the chosen provider, e.g.:
#   ollama     : qwen2.5:32b, qwen2.5:14b, llama3.2
#   openai     : gpt-4o-mini, gpt-4o
#   groq       : llama-3.3-70b-versatile
#   openrouter : meta-llama/llama-3.3-70b-instruct:free
MODEL_NAME=qwen2.5:32b

# API key for the hosted providers (openai / groq / openrouter / custom).
# Leave empty when using Ollama - local inference needs no key.
OPENAI_API_KEY=

# Ollama's OpenAI-compatible endpoint (default shown).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only used when MODEL_PROVIDER=custom (any OpenAI-compatible server).
# CUSTOM_BASE_URL=https://my-gateway.example.com/v1

# Optional tuning (defaults shown).
# LLM_TEMPERATURE=0.6
# LLM_MAX_RETRIES=3
# Large local models can take minutes per response on consumer hardware,
# so the timeout is deliberately generous.
# REQUEST_TIMEOUT_SECONDS=900
# MAX_SEARCH_RESULTS=8
